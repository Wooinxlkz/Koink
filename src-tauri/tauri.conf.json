{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koink",
  "version": "0.1.0",
  "identifier": "app.koink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koink",
        "width": 420,
        "height": 640,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
